{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Database=toolinstructor;Username=admin;Password=secure_password_123",
    "Redis": "localhost:6379"
  },
  "Qdrant": {
    "Host": "localhost",
    "Port": 6333,
    "UseHttps": false,
    "ApiKey": "",
    "CollectionName": "tools"
  },
  "OpenAI": {
    "ApiKey": "secret_api_key",
    "Model": "gpt-4-turbo-preview",
    "EmbeddingModel": "text-embedding-ada-002",
